/** Conditional cash-use scenarios, separate from physical forecast generation.
 * No scenario supplies live admission, exchange fills or member cash authority. */
import {scheduledFee} from './fees.mjs';
const pips=x=>{const n=Math.round(x*10000);if(!Number.isSafeInteger(n)||Math.abs(x*10000-n)>1e-6)throw new RangeError('centicent monetary input required');return n;};
/** Every execution contains integer hundredths. Ceiling is subadditive against
 * splitting into those atoms: ceil(q*a) <= q*ceil(a). Max over eligible observed
 * prices bounds cost/fee-rounding adjustment for every displayed-depth partition.
 * This is an upper reserve, not a prediction of the venue's execution fee. */
export function fragmentedWeatherFeeReserve(theta,count,prices){
 const countAtoms=Math.round(count*100);
 if(!Number.isFinite(theta)||theta<0||!Number.isSafeInteger(countAtoms)||countAtoms<0||countAtoms>1000000||Math.abs(count*100-countAtoms)>1e-6||!Array.isArray(prices)||!prices.length)throw new RangeError('finite coefficient, hundredth count and observed prices required');
 const atoms=prices.map(price=>{if(!Number.isFinite(price)||price<=0||price>=1)throw new RangeError('strict binary price required');pips(price);const adjustment=Math.round(scheduledFee(theta,.01,price)*1000000);if(!Number.isSafeInteger(adjustment)||adjustment<0)throw new RangeError('supported atomic cost/fee adjustment required');return adjustment;});
 const feeMicros=countAtoms*Math.max(...atoms);if(!Number.isSafeInteger(feeMicros))throw new RangeError('supported fee reserve required');return feeMicros/1000000;
}
/** Sharp Frechet bounds for W=winning side and F=full fill before expiry.
 * P(W and F) lies in [max(0,p+f-1),min(p,f)]. Optimizing that joint
 * law and net=joint-cost*f preserves dependence. Supplied marginals remain
 * assumptions; a full-fill/no-fill event does not model partial executions. */
export function weatherFillSelectionBounds({winProbabilityLow,winProbabilityHigh,fillProbabilityLow=0,fillProbabilityHigh=1,costPerContractUsd}){
 const pl=winProbabilityLow,ph=winProbabilityHigh,fl=fillProbabilityLow,fh=fillProbabilityHigh,cost=costPerContractUsd;
 if(![pl,ph,fl,fh,cost].every(Number.isFinite)||pl<0||ph>1||pl>ph||fl<0||fh>1||fl>fh||cost<0)throw new RangeError('ordered unit probability intervals and finite nonnegative cost required');
 const clamp=x=>Math.max(fl,Math.min(fh,x));
 const low=f=>Math.max(0,pl+f-1)-cost*f,high=f=>Math.min(ph,f)-cost*f;
 const lowerNet=Math.min(...[fl,fh,clamp(1-pl)].map(low)),upperNet=Math.max(...[fl,fh,clamp(ph)].map(high));
 const conditionalLow=fh===0?null:fl===0?(pl===1?1:0):Math.max(0,1-(1-pl)/fl),conditionalHigh=fh===0?null:fl===0?(ph===0?0:1):Math.min(1,ph/fl);
 return {marginalWinProbability:{low:pl,high:ph},assumedFullFillProbability:{low:fl,high:fh},costPerContractUsd:cost,conditionalWinProbabilityLow:conditionalLow,conditionalWinProbabilityHigh:conditionalHigh,expectedNetPerPostedContractLowUsd:lowerNet,expectedNetPerPostedContractHighUsd:upperNet,conditionalNetPerFilledContractLowUsd:conditionalLow===null?null:conditionalLow-cost,conditionalNetPerFilledContractHighUsd:conditionalHigh===null?null:conditionalHigh-cost,method:'sharp binary-event Frechet bounds; no independence assumption',scope:'supplied valid marginal intervals and full-fill/no-fill scenario; partial fills and calibration not identified',actualFillProbability:null,actualConditionalWinProbability:null,tradeAuthority:false};
}

/** Greedy research proposal under explicit, unvalidated conditional probability
 * and usable-cash-time bounds. Rank by conservative net per dollar-hour after an
 * explicit holding hurdle, reserve priority cash first, and consume cash once.
 * Correlated losses, actual fill law and settlement-time distributions are open. */
export function weatherCarryAllocation(snapshot,policy,{now}={}){
 if(!Number.isFinite(now)||!Array.isArray(snapshot?.rows)||!policy||!Array.isArray(policy.cases)||!policy.cases.length||policy.cases.length>2*snapshot.rows.length)throw new TypeError('captured actions and bounded conditional cases required');
 const availablePips=pips(snapshot.availableCapitalUsd),priorityPips=pips(policy.priorityReserveUsd??0),hourlyRate=policy.hourlyCashHurdle??0,minWin=policy.minimumWinSurplusUsd??0;
 if(availablePips<0||priorityPips<0||priorityPips>availablePips||!Number.isFinite(hourlyRate)||hourlyRate<0||!Number.isFinite(minWin)||minWin<0)throw new RangeError('finite captured and priority cash, holding hurdle and win surplus required');
 const budgetPips=availablePips-priorityPips,lossPips=policy.maxLossBudgetUsd===undefined?budgetPips:pips(policy.maxLossBudgetUsd);if(lossPips<0)throw new RangeError('nonnegative worst loss budget required');
 const actions=new Map();for(const row of snapshot.rows)for(const action of row.actions.alternatives){if(actions.has(action.id))throw new TypeError('ambiguous captured action');actions.set(action.id,{row,action});}
 const seen=new Set(),evaluations=policy.cases.map(c=>{
  if(!c||typeof c.actionId!=='string'||seen.has(c.actionId))throw new TypeError('distinct conditional action cases required');seen.add(c.actionId);
  const bound=actions.get(c.actionId);if(!bound||bound.action.action!=='rest')throw new TypeError('captured resting action required');const {row,action}=bound;
  if(row.market?.market_type!=='binary'||Number(row.market.notional_value_dollars)!==1)throw new TypeError('observed one-dollar binary face value required');
  if(Date.parse(row.actions.observedAt)>now||!Number.isFinite(Date.parse(row.actions.expiresAt))||Date.parse(row.actions.expiresAt)<=now)throw new TypeError('fresh causal quote required');
  const low=c.winProbabilityLow,high=c.winProbabilityHigh,early=Date.parse(c.usableCashAtEarliest),late=Date.parse(c.usableCashAtLatest);
  if(![low,high].every(Number.isFinite)||low<0||high>1||low>high||!Number.isFinite(early)||!Number.isFinite(late)||early<now||late<early||late<=now)throw new TypeError('explicit conditional probability and future usable-cash interval required');
  const costPips=pips(action.capitalRequiredUsd),cost=costPips/10000,n=action.quantity;if(cost<=0||!Number.isInteger(n)||n<1||n>10000)throw new TypeError('captured finite cost and whole quantity required');
  const earlyHours=(early-now)/3600000,lateHours=(late-now)/3600000,lowerNet=n*low-cost,upperNet=n*high-cost,lowerAfter=lowerNet-cost*hourlyRate*lateHours,upperAfter=upperNet-cost*hourlyRate*earlyHours,winSurplus=n-cost;
  return {actionId:c.actionId,ticker:row.ticker,side:action.side,quantity:n,price:action.price,pips:action.pips,costPips,capitalRequiredUsd:cost,winSurplusUsd:winSurplus,worstLossUsd:cost,breakEvenConditionalWinProbability:cost/n,breakEvenWithHoldingHurdle:(cost+cost*hourlyRate*lateHours)/n,conditionalNetLowUsd:lowerNet,conditionalNetHighUsd:upperNet,conditionalNetAfterHurdleLowUsd:lowerAfter,conditionalNetAfterHurdleHighUsd:upperAfter,heldHoursLow:earlyHours,heldHoursHigh:lateHours,lowerNetPerDollarHour:lowerAfter/(cost*lateHours),qualifiesUnderAssumptions:lowerAfter>0&&winSurplus>=minWin,assumptions:{...c,status:'unvalidated conditional-on-full-fill scenario; usable cash time is assumed, not certified by close time'},fillProbability:null,tradeAuthority:false};
 });
 const candidates=evaluations.filter(e=>e.qualifiesUnderAssumptions).sort((a,b)=>b.lowerNetPerDollarHour-a.lowerNetPerDollarHour||a.actionId.localeCompare(b.actionId)),selected=[],skipped=[],sides=new Map();let spentPips=0;
 for(const e of candidates){const prices=sides.get(e.ticker)??new Map(),other=prices.get(e.side==='yes'?'no':'yes');let reason=null;
  if(prices.has(e.side))reason='same-side alternative already selected';else if(other!==undefined&&other+e.pips>=10000)reason='mutually crossing resting quotes';else if(spentPips+e.costPips>budgetPips)reason='priority cash or remaining cash';else if(spentPips+e.costPips>lossPips)reason='worst-loss budget';
  if(reason){skipped.push({actionId:e.actionId,reason});continue;}prices.set(e.side,e.pips);sides.set(e.ticker,prices);spentPips+=e.costPips;selected.push(e);
 }
 return {kind:'weather-carry-allocation-v1',at:new Date(now).toISOString(),priorityReserveUsd:priorityPips/10000,carryBudgetUsd:budgetPips/10000,carryReserveUsd:spentPips/10000,remainingCarryCashUsd:(budgetPips-spentPips)/10000,worstLossUsd:spentPips/10000,conditionalNetAfterHurdleLowUsd:selected.reduce((s,e)=>s+e.conditionalNetAfterHurdleLowUsd,0),selectedActionIds:selected.map(e=>e.actionId),evaluations,skipped,method:'greedy lower conditional net per dollar-hour; optimality unproven',selectionIsOptimal:false,fillProbability:null,scope:'full-fill expected-value and capital-use scenarios under supplied assumptions; no calibrated conditional probability, guaranteed payout or usable-cash deadline',orderEffect:false,tradeAuthority:false};
}
