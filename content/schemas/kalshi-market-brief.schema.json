{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:561-group:forecasting:kalshi-market-brief:v1",
  "title": "KalshiMarketBrief",
  "description": "One Kalshi event's research record, shared by the Kalshi desk (allocator opportunities) and Koios.News (article source). Built by src/kalshi-market-brief.mjs.",
  "type": "object",
  "required": ["type", "version", "briefId", "asOf", "event", "rules", "settlementSource", "markets", "book", "house", "whatWouldMoveIt", "opportunities", "provenance", "disclosure"],
  "properties": {
    "type": { "const": "KalshiMarketBrief" },
    "version": { "const": 1 },
    "briefId": { "type": "string" },
    "asOf": { "type": "string", "format": "date-time" },
    "event": {
      "type": "object",
      "required": ["eventTicker", "seriesTicker", "title", "category", "closesAt", "expectedSettleAt", "settlesOn", "hoursToClose", "url", "seriesUrl"],
      "properties": {
        "eventTicker": { "type": "string" }, "seriesTicker": { "type": "string" }, "title": { "type": "string" }, "subTitle": { "type": "string" },
        "category": { "type": "string" }, "frequency": { "type": ["string", "null"] }, "mutuallyExclusive": { "type": "boolean" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "closesAt": { "type": "string", "format": "date-time" }, "expectedSettleAt": { "type": "string", "format": "date-time" },
        "settlesOn": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }, "hoursToClose": { "type": "number" },
        "feeMultiplier": { "type": "number" },
        "url": { "type": "string", "format": "uri", "description": "https://kalshi.com/markets/{series}/{series-title-slug}/{event}, tickers lowercase" },
        "seriesUrl": { "type": "string", "format": "uri", "description": "https://kalshi.com/markets/{series}; always resolves" }
      }
    },
    "rules": { "type": "object", "required": ["primary"], "properties": { "primary": { "type": "string" }, "secondary": { "type": "string" }, "contractTermsUrl": { "type": ["string", "null"] }, "leadMarket": { "type": "string" }, "perMarket": { "type": "boolean" } } },
    "settlementSource": {
      "type": "object", "required": ["primary", "all"],
      "properties": {
        "primary": { "type": ["object", "null"], "properties": { "name": { "type": "string" }, "url": { "type": "string" } } },
        "all": { "type": "array", "items": { "type": "object", "properties": { "name": { "type": "string" }, "url": { "type": "string" } } } }
      }
    },
    "markets": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["ticker", "label", "yesBidCents", "yesAskCents", "noBidCents", "noAskCents", "impliedYes", "volume24h"],
        "properties": {
          "ticker": { "type": "string" }, "label": { "type": "string" }, "title": { "type": "string" },
          "strike": { "type": "object", "properties": { "type": { "type": ["string", "null"] }, "floor": { "type": ["number", "null"] }, "cap": { "type": ["number", "null"] } } },
          "yesBidCents": { "type": ["integer", "null"] }, "yesAskCents": { "type": ["integer", "null"] },
          "noBidCents": { "type": ["integer", "null"] }, "noAskCents": { "type": ["integer", "null"] }, "lastCents": { "type": ["integer", "null"] },
          "bidSize": { "type": ["number", "null"] }, "askSize": { "type": ["number", "null"] },
          "volume": { "type": "number" }, "volume24h": { "type": "number" }, "openInterest": { "type": "number" },
          "impliedYes": { "type": ["number", "null"], "minimum": 0, "maximum": 1, "description": "mid of the two-sided book, else the last trade" },
          "impliedYesNormalized": { "type": ["number", "null"], "description": "mid / sum of mids, only for mutually exclusive events" },
          "house": { "type": ["object", "null"], "properties": { "probability": { "type": ["number", "null"] }, "kind": { "type": ["string", "null"] }, "model": { "type": ["string", "null"] }, "reason": { "type": "string" } } },
          "baseRate": { "type": ["object", "null"], "description": "the sample rate of settled markets quoted in the same band", "properties": { "band": { "enum": ["longshot", "favorite"] }, "scope": { "enum": ["family", "category"] }, "n": { "type": "integer" }, "yesRate": { "type": ["number", "null"] }, "yesRate95": { "type": "array", "items": { "type": ["number", "null"] } }, "horizonHours": { "type": "number" } } }
        }
      }
    },
    "book": { "type": "object", "required": ["markets", "volume24h", "openInterest", "midSum"], "properties": { "markets": { "type": "integer" }, "volume24h": { "type": "number" }, "openInterest": { "type": "number" }, "midSum": { "type": "number" } } },
    "house": {
      "type": "object", "required": ["model", "status", "evidence"],
      "properties": {
        "model": { "type": ["string", "null"] }, "status": { "enum": ["priced", "unpriced", "no-model"] }, "reason": { "type": "string" },
        "evidence": { "type": "array", "items": { "type": "object", "required": ["label", "value"], "properties": { "label": { "type": "string" }, "value": { "type": "string" }, "url": { "type": "string" } } } },
        "usableAs": { "type": ["string", "null"] }
      }
    },
    "baseRate": { "type": ["object", "null"], "properties": { "category": { "type": ["object", "null"] }, "family": { "type": ["object", "null"] } } },
    "whatWouldMoveIt": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "opportunities": {
      "type": "array",
      "description": "Allocator opportunities: the contract of the bids consumer. See the header of src/kalshi-market-brief.mjs.",
      "items": {
        "type": "object", "required": ["marketTicker", "eventTicker", "lane", "side", "priceCents", "payoffCents", "winProbability", "edgeCents", "settlesOn", "correlation", "briefId", "asOf"],
        "properties": {
          "marketTicker": { "type": "string" }, "eventTicker": { "type": "string" }, "lane": { "type": "string" }, "side": { "enum": ["yes", "no"] },
          "priceCents": { "type": "integer", "minimum": 1, "maximum": 99 }, "restingPriceCents": { "type": ["integer", "null"] },
          "payoffCents": { "type": "integer" }, "winProbability": { "type": "number", "minimum": 0, "maximum": 1 }, "point": { "type": ["number", "null"] },
          "feeCents": { "type": "number" }, "edgeCents": { "type": "number" },
          "settlesOn": { "type": "string" }, "settlesAt": { "type": "string" },
          "correlation": { "type": "object", "required": ["event", "series", "settlementDate"], "properties": { "event": { "type": "string" }, "series": { "type": "string" }, "settlementDate": { "type": "string" } } },
          "briefId": { "type": "string" }, "asOf": { "type": "string" }
        }
      }
    },
    "provenance": { "type": "array", "items": { "type": "object", "required": ["what", "fetchedAt"], "properties": { "what": { "type": "string" }, "url": { "type": ["string", "null"] }, "fetchedAt": { "type": "string" } } } },
    "disclosure": { "type": "string" }
  }
}
