+/** Exact executable book in upstream gaming's graded monetary carrier. */
+export function orderBookOf(position, ticker, side = 'yes') {
+  const m = marketAt(position, ticker);
+  if (!m?.yes || m.stale || ['closed', 'determined', 'settled', 'deactivated'].includes(m.status)) throw new RangeError('known live depth required');
+  if (!['yes', 'no'].includes(side)) throw new TypeError('YES or NO book required');
+  const levels = (ladder, complement = false) => Object.entries(ladder).map(([p, q]) => ({ price: gradedFromParts(complement ? ONE - Number(p) : Number(p), ONE, 'USD'), quantity: gradedFromParts(q, 100, `kalshi:${ticker}:${side}`) }));
+  return { bids: levels(m[side]), asks: levels(m[side === 'yes' ? 'no' : 'yes'], true) };
+}
+
+/** Depth, slippage and liquidity shortfall use the one upstream book walk. */
+export function walkTake(position, ticker, side, quantityHundredths, action = 'buy') {
+  if (!Number.isSafeInteger(quantityHundredths) || quantityHundredths < 1) throw new RangeError('positive quantity in hundredths required');
+  if (!['buy', 'sell'].includes(action)) throw new TypeError('buy or sell action required');
+  const quantity = gradedFromParts(quantityHundredths, 100, `kalshi:${ticker}:${side}`);
+  return (action === 'buy' ? marketBuyWalk : marketSellWalk)(orderBookOf(position, ticker, side), quantity);
+}
