  "provenance": {
    "record": "data/records/2026-10-04-weather-coverage (results/rain-model.md, results/rain-edges.md, scripts/rain_dataset.py, scripts/rain_model.py)",
    "fitted": "2026-10-04",
    "data": "1524 settled KXRAIN markets 2026-07-26..2026-10-02, 28 city codes; NBS P06 from IEM's archive; truth is Kalshi's own results",
    "feature": "pany = 1 - prod(1 - P06/100) over the NBS 6-hour periods whose midpoint lies inside the station's local-standard-time climate day (strictly; at least 3 periods)",
    "form": "P(yes) = sigmoid(w0 + w1 * logit(clamp(pany, eps, 1 - eps))), eps = 0.001",
    "frozen": "weights are the single fit on ALL rows of each decision time (ridge 1e-3 on w1, BFGS), the record's two cross-fit halves are kept in crossFit for audit. The record's edge tables used the cross-fit predictions (each row out of sample); the frozen weights are in-sample on those rows, so quote the record's numbers as an upper estimate until the forward test (kalshi-stake-path-service lane daily-rain) confirms them.",
    "heldOut": "Out-of-fold Brier at D-1 15h 0.0885 (Kalshi mid 0.0903), D-1 21h 0.0854 (mid 0.0848); same-day 07h 0.0810 vs mid 0.0670 so the market is better than the model on the day itself and no same-day decision time is used."
  },
  "series": "KXRAIN",
  "eps": 0.001,
  "minPeriods": 3,
  "settlement": {
    "source": "The Weather Company (weather.com/kalshi), station CLIxxx",
    "rule": "total precipitation strictly greater than 0 inches over the local day; trace amounts and missing values count as 0 inches",
    "traceCountsAsZero": true,
    "earlyClose": {
      "canCloseEarly": true,
      "condition": "the market closes and expires early (resolves yes) the first time rain occurs; close_time is only the latest close",
      "consequence": "a settled-yes market may be settled before its close_time; the tail seller's loss arrives early, the favourite buyer's win arrives early; a market that is still open at its close_time without rain settles no"
    }
  },
