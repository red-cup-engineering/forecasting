/** Weather-market actions, separate from physical forecast generation.
 * Observed depth and conditional commitments do not identify maker fills. */
import {initialPosition,extend,moveOfFrame,marketAt,queueAhead,walkTake,shadowRest,ONE} from './arena.mjs';
import {feeTerms} from './fees.mjs';
import {fragmentedWeatherFeeReserve as feeReserve,weatherFillSelectionBounds} from './weather-capital.mjs';
import {gradedFromParts,gradedToDecimalString} from '@red-cup-engineering/computer-data-engineering-services-section/number/graded';
const number=g=>{const [n,d='1']=gradedToDecimalString(g).split('/'),v=Number(n)/Number(d);if(!Number.isFinite(v))throw new RangeError('finite monetary projection required');return v;};
const clock=x=>Date.parse(x);
const fixed=(x,n)=>{const y=Number(x)*n;if(!Number.isSafeInteger(Math.round(y))||Math.abs(y-Math.round(y))>1e-6)throw new RangeError('unsupported fixed-point trade');return Math.round(y);};
// Reserves use scheduled centicent rounding over integer-hundredth executions.
function improvingPrice(market,bid,ask,side){
 const ranges=market.price_ranges;
 if(!Array.isArray(ranges))return null;
 const candidates=[];
 for(const r of ranges){const a=Number(r.start),b=Number(r.end),step=Number(r.step);
  if(![a,b,step].every(Number.isFinite)||a<0||b>1||a>=b||step<=0)continue;
  const tick=fixed(step,ONE),start=fixed(a,ONE),end=fixed(b,ONE),p=side==='yes'?bid+tick:ONE-bid-tick;
  if(p>=start&&p<=end&&(p-start)%tick===0){const q=side==='yes'?p:ONE-p;if(q>bid&&q<ask)candidates.push(q);}
 }
 return candidates.length?Math.min(...candidates):null;
}
function legalQuotePrice(market,side,pips){
 const price=side==='yes'?pips:ONE-pips;
 return Array.isArray(market.price_ranges)&&market.price_ranges.some(r=>{const start=fixed(r.start,ONE),end=fixed(r.end,ONE),step=fixed(r.step,ONE);return step>0&&price>=start&&price<=end&&(price-start)%step===0;});
}
export function weatherParticipationActions({market,book,series,models,capitalUsd,contracts=1,observedAt,expiresAt,quoteIntents=[]}){
 if(typeof market?.ticker!=='string'||market.status!=='active'||!Number.isFinite(clock(market.close_time))||clock(market.close_time)<=clock(observedAt))throw new TypeError('open live contract required');
 if(!Number.isFinite(capitalUsd)||capitalUsd<0||!Number.isInteger(contracts)||contracts<1||contracts>10000||!Number.isFinite(clock(observedAt))||!Number.isFinite(clock(expiresAt))||clock(expiresAt)<=clock(observedAt)||clock(expiresAt)>clock(market.close_time))throw new TypeError('finite capital, whole quantity and bounded commitment lifetime required');
 if(!Array.isArray(models)||!models.length||models.some(m=>!m.id||!Number.isFinite(m.p)||m.p<0||m.p>1))throw new TypeError('frozen model probabilities required');
 if(!Array.isArray(quoteIntents)||quoteIntents.some(q=>!q||!['yes','no'].includes(q.side)||(q.ticker!==undefined&&q.ticker!==market.ticker))||new Set(quoteIntents.map(q=>q.side+':'+fixed(q.price,ONE))).size!==quoteIntents.length)throw new TypeError('distinct scoped quote intentions required');
 for(const rows of [book?.yes_dollars,book?.no_dollars]){if(!Array.isArray(rows)||new Set(rows.map(r=>fixed(r?.[0],ONE))).size!==rows.length)throw new TypeError('distinct bid price levels required');for(const [p,q] of rows){const price=fixed(p,ONE),size=fixed(q,100);if(price<=0||price>=ONE||size<0)throw new TypeError('valid fixed-point depth required');}}
 const position=extend(initialPosition(),moveOfFrame({type:'orderbook_snapshot',msg:{market_ticker:market.ticker,yes_dollars_fp:book.yes_dollars,no_dollars_fp:book.no_dollars}})).state;
 const fees=feeTerms(series),m=marketAt(position,market.ticker),alternatives=[{id:market.ticker+':wait',action:'wait',capitalRequiredUsd:0,reason:'retain cash and obtain further evidence'}],questions=[];
 for(const side of ['yes','no']){
  const own=m[side],opposite=m[side==='yes'?'no':'yes'],bids=Object.keys(own).filter(p=>own[p]>0).map(Number),offers=Object.keys(opposite).filter(p=>opposite[p]>0).map(p=>ONE-Number(p));
  const bid=bids.length?Math.max(...bids):null,ask=offers.length?Math.min(...offers):null;
  const probabilities=models.map(model=>({model:model.id,p:side==='yes'?model.p:1-model.p,forecastAdmitted:Boolean(model.band?.admitted)}));
  const takeFee=(take,n)=>feeReserve(fees.taker,n,offers.filter(p=>p<=Math.round(number(take.worst)*ONE)).map(p=>p/ONE));
  if(ask!==null){
   const available=Math.floor(number(walkTake(position,market.ticker,side,contracts*100).filled));
   let lo=0,hi=Math.min(contracts,available);
   while(lo<hi){const n=Math.ceil((lo+hi)/2),take=walkTake(position,market.ticker,side,n*100),cost=number(take.cost)+takeFee(take,n);if(cost<=capitalUsd+1e-9)lo=n;else hi=n-1;}
   if(lo){const take=walkTake(position,market.ticker,side,lo*100),entryCostUsd=number(take.cost),feeUpperUsd=takeFee(take,lo),capitalRequiredUsd=(Math.round(entryCostUsd*10000)+Math.round(feeUpperUsd*10000))/10000;
    alternatives.push({id:market.ticker+':'+side+':take',action:'take',side,quantity:lo,limitPrice:number(take.worst),averagePrice:number(take.averagePrice),averagePriceExactUsd:gradedToDecimalString(take.averagePrice),entryCostExactUsd:gradedToDecimalString(take.cost),entryCostUsd,feeUpperUsd,capitalRequiredUsd,displayedLevels:take.levels,requestedQuantity:contracts,depthShortfall:contracts-available,execution:'immediate-or-cancel scenario; displayed liquidity can change before acknowledgment',breakEvenWinProbability:capitalRequiredUsd/lo,expectedNetUnderModels:probabilities.map(p=>({...p,usd:lo*p.p-capitalRequiredUsd})),actualFill:null});
   }
  }
  const prices=new Map();if(bid!==null&&(ask===null||bid<ask)){prices.set(bid,{quantity:contracts,basis:'observed bid'});if(ask!==null){const improved=improvingPrice(market,bid,ask,side);if(improved!==null)prices.set(improved,{quantity:contracts,basis:'one-tick improvement'});}}
  for(const intent of quoteIntents.filter(q=>q.side===side)){
   const pips=fixed(intent.price,ONE),quantity=intent.quantity??contracts;
   if(pips<=0||pips>=ONE||!legalQuotePrice(market,side,pips)||!Number.isInteger(quantity)||quantity<1||quantity>10000)throw new TypeError('proposed quote needs observed legal ticks and whole quantity');
   if(ask!==null&&pips>=ask)throw new TypeError('proposed resting quote would cross the observed offer');
   prices.set(pips,{quantity,basis:bid===null?'proposed initial bid':pips<bid?'proposed below-best bid':'proposed bid'});
  }
  if(prices.size){
   for(const [pips,intent] of prices){const price=pips/ONE;let count=Math.min(intent.quantity,Math.floor(capitalUsd/(price+feeReserve(fees.maker,1,[price]))+1e-9));
    while(count>0&&count*price+feeReserve(fees.maker,count,[price])>capitalUsd+1e-9)count--;if(!count)continue;
    const feeUpperUsd=feeReserve(fees.maker,count,[price]),capitalRequiredUsd=(count*pips+Math.round(feeUpperUsd*10000))/10000,id=market.ticker+':'+side+':rest:'+pips;
    alternatives.push({id,action:'rest',side,price,pips,quantity:count,requestedQuantity:intent.quantity,priceBasis:intent.basis,queueAheadAtObservedPrice:queueAhead(position,market.ticker,side,pips),initialBetterPriceQueue:bids.filter(p=>p>pips).reduce((s,p)=>s+own[p],0)/100,conditionalQueueReplaySupported:!bids.some(p=>p>pips),capitalRequiredUsd,feeUpperUsd,postOnly:true,expiresAt,breakEvenConditionalWinProbability:capitalRequiredUsd/count,fillProbability:null,conditionalWinProbability:null,unconditionalForecastScenarios:probabilities.map(p=>({...p,usdIfFullyFilledAtUnconditionalProbability:count*p.p-capitalRequiredUsd,selectionBoundsAssumingMarginalForecast:weatherFillSelectionBounds({winProbabilityLow:p.p,winProbabilityHigh:p.p,costPerContractUsd:capitalRequiredUsd/count})})),actualFill:null});
    questions.push({kind:'fill-selection',locus:id,question:'What is the probability of this side winning conditional on this quote filling before expiry?',prerequisites:['prospective quote receipt','subsequent book events and own order acknowledgments','exact venue outcome'],known:'unconditional weather laws and initial queue; fill-selection law remains unidentified'});
   }
  }
 }
 return {ticker:market.ticker,observedAt,expiresAt,capitalUsd,contracts,fees,feeBasis:'observed series/event terms; scheduled cost+fee centicent rounding; bound over hundredth execution fragments at observed prices',forecastModels:models.map(m=>({id:m.id,p:m.p,band:m.band??null})),alternatives,questions,alternativesAreMutuallyExclusivePerSide:true,capitalReservedUsd:0,orderEffect:false,tradeAuthority:false};
}
/** Observed trades inform a conditional queue scenario. They cannot establish
 * our absent order's fill, queue evolution, latency, or market impact. */
export function reviewWeatherParticipation(row,{trades,complete,reviewedAt,outcome=null,marketType=null,notionalValueUsd=null}){
 if(!Number.isFinite(clock(reviewedAt))||clock(reviewedAt)<clock(row.observedAt))throw new TypeError('causal review clock required');
 const end=Math.min(clock(row.expiresAt),clock(reviewedAt)),begin=clock(row.observedAt),seen=new Map(),excluded=new Set(),tradeConflicts=[];
 for(const t of trades??[]){
  if(t?.ticker!==row.ticker||t.is_block_trade===true)continue;const time=clock(t.created_time);
  if(!Number.isFinite(time)){tradeConflicts.push({kind:'invalid-clock',witnesses:[t]});continue;}if(time<=begin||time>end)continue;
  if(typeof t.trade_id!=='string'||!t.trade_id){tradeConflicts.push({kind:'missing-identity',witnesses:[t]});continue;}
  if(seen.has(t.trade_id)&&JSON.stringify(seen.get(t.trade_id))!==JSON.stringify(t)){excluded.add(t.trade_id);tradeConflicts.push({kind:'contradictory-identity',tradeId:t.trade_id,witnesses:[seen.get(t.trade_id),t]});}else seen.set(t.trade_id,t);
 }
 const tape=[];for(const t of seen.values()){
  if(excluded.has(t.trade_id))continue;
  try{
   const directions=[t.taker_outcome_side,t.taker_book_side===undefined?undefined:t.taker_book_side==='bid'?'yes':t.taker_book_side==='ask'?'no':'invalid',t.taker_side].filter(x=>x!==undefined);
   if(!directions.length||directions.some(x=>!['yes','no'].includes(x))||new Set(directions).size!==1)throw new TypeError('missing or contradictory trade direction');
   const price=fixed(t.yes_price_dollars,ONE),size=fixed(t.count_fp,100);if(price<=0||price>=ONE||size<=0)throw new TypeError('positive valid trade required');
   tape.push({kind:'take',ticker:t.ticker,t:clock(t.created_time),price,size,taker:directions[0],tradeId:t.trade_id});
  }catch(error){tradeConflicts.push({kind:'invalid-trade',tradeId:t.trade_id,reason:error.message,witnesses:[t]});}
 }
 tape.sort((a,b)=>a.t-b.t||a.tradeId.localeCompare(b.tradeId));
 const windowComplete=Boolean(complete)&&clock(reviewedAt)>=clock(row.expiresAt)&&!tradeConflicts.length,binary=outcome&&[0,1].includes(outcome.outcome)?outcome.outcome:null;
 const finalLabel=binary!==null&&outcome.ticker===row.ticker&&outcome.marketType==='binary'&&outcome.is_provisional!==true&&['settled','finalized'].includes(outcome.status)&&outcome.result===(binary?'yes':'no')&&Number.isFinite(clock(outcome.settledAt))&&clock(outcome.settledAt)>=begin&&clock(outcome.settledAt)<=clock(reviewedAt);
 const oneDollarBinary=marketType==='binary'&&notionalValueUsd===1;
 const counterpartyTrades=tape.map(t=>{
  const side=t.taker==='yes'?'no':'yes',pricePips=side==='yes'?t.price:ONE-t.price,win=finalLabel&&clock(outcome.settledAt)>=t.t?(side==='yes'?binary:1-binary):null;
  const gross=win===null||!oneDollarBinary?null:gradedFromParts(BigInt(t.size)*BigInt(win*ONE-pricePips),1000000n,'USD');
  return {tradeId:t.tradeId,executedAt:new Date(t.t).toISOString(),takerOutcomeSide:t.taker,counterpartyOutcomeSide:side,purchaseEquivalentPrice:pricePips/ONE,pricePips,quantity:t.size/100,quantityHundredths:t.size,finalWin:win,grossPurchaseEquivalentPayoffUsd:gross===null?null:number(gross),grossPurchaseEquivalentPayoffExactUsd:gross===null?null:gradedToDecimalString(gross),netProfitUsd:null,memberUsableCashAt:null,ourFill:null};
 });
 return {ticker:row.ticker,observedAt:row.observedAt,reviewedAt,expiresAt:row.expiresAt,windowComplete,observedNonblockTrades:tape.length,tradeConflicts,outcome,publicCounterpartyEvidence:{trades:counterpartyTrades,finalLabelAvailable:finalLabel,oneDollarBinary,tapeWindowComplete:windowComplete,population:'observed public counterparties in the captured receipt window; positions and quote placement histories unknown',scope:'purchase-equivalent gross exposure payoff; no actual participant PnL, charged fees, member cash release or our fill-law estimate',ourFillProbability:null,ourConditionalWinProbability:null,independentTrials:null,tradeAuthority:false},actions:row.alternatives.map(a=>{
  if(a.action==='wait')return {id:a.id,action:'wait',capitalConsumedUsd:0};
  if(a.action==='take')return {id:a.id,action:a.action,hypotheticalFullDisplayedFillPnlUsd:binary===null?null:a.quantity*(a.side==='yes'?binary:1-binary)-a.capitalRequiredUsd,actualFill:null};
  const replay=windowComplete&&!(a.initialBetterPriceQueue>0)?shadowRest({ticker:row.ticker,side:a.side,price:a.pips,size:a.quantity,placedAt:begin},a.queueAheadAtObservedPrice,tape):null;
  return {id:a.id,action:a.action,conditionalQueueReplay:replay,queueReplayBlocker:a.initialBetterPriceQueue>0?'initial better-price priority requires a fuller book-event replay':null,hypotheticalReplayPnlUsd:binary===null||!replay?null:replay.filled*((a.side==='yes'?binary:1-binary)-a.price)-feeReserve(row.fees.maker,replay.filled,[a.price]),actualFill:null};
 }),executionAssumptions:['no actual order, acknowledgment or exchange queue position','zero placement latency and no market impact','initial displayed queue; cancellations give no queue credit','new orders with better price priority are unobserved and assumed absent; replay is not a fill bound','trade publication may lag review receipt; endpoint pagination completeness does not certify complete exchange history'],orderEffect:false,tradeAuthority:false};
}

/** Fresh fee observations include event overrides and impending fee changes. */
export async function readWeatherParticipationFees(client,contract,{now=Date.now(),seriesObservations}={}){
 // Share only fresh, capture-local observations; never persist fee assumptions.
 const load=()=>client.getSeries(contract.seriesTicker).then(series=>({series,seriesReceivedAt:new Date().toISOString()}));
 let observation=seriesObservations?.get(contract.seriesTicker);if(!observation){observation=load();seriesObservations?.set(contract.seriesTicker,observation);}
 const {series,seriesReceivedAt}=await observation,pages=[],changes=[];let cursor;
 if(series.ticker!==undefined&&series.ticker!==contract.seriesTicker)throw new TypeError('series fee observation scope mismatch');
 for(let page=0;page<3;page++){
  const packet=await client.call('GET','/events/fee_changes',{signed:false,query:{event_ticker:contract.event_ticker,limit:1000,cursor}});pages.push({receivedAt:new Date().toISOString(),packet});
  if(!Array.isArray(packet.event_fee_changes))throw new TypeError('event fee observations missing');changes.push(...packet.event_fee_changes);cursor=packet.cursor;if(!cursor)break;
 }
 if(cursor)throw new TypeError('event fee change pagination incomplete');
 if(changes.some(r=>r.event_ticker!==contract.event_ticker||r.series_ticker!==contract.seriesTicker||!Number.isFinite(clock(r.scheduled_ts))))throw new TypeError('event fee scope or clock mismatch');
 const active=changes.filter(r=>clock(r.scheduled_ts)<=now).sort((a,b)=>clock(b.scheduled_ts)-clock(a.scheduled_ts)),latest=active[0],effective={...series};
 if(latest){
  if(active.filter(r=>r.scheduled_ts===latest.scheduled_ts).some(r=>r.fee_type_override!==latest.fee_type_override||r.fee_multiplier_override!==latest.fee_multiplier_override))throw new TypeError('conflicting simultaneous event fees');
  if(latest.fee_type_override===null&&latest.fee_multiplier_override===null){}else{
   if(latest.fee_type_override===null||latest.fee_multiplier_override===null)throw new TypeError('partial event fee override');
   effective.fee_type=latest.fee_type_override;effective.fee_multiplier=latest.fee_multiplier_override;
  }
 }
 feeTerms(effective);
 const future=changes.filter(r=>clock(r.scheduled_ts)>now).sort((a,b)=>clock(a.scheduled_ts)-clock(b.scheduled_ts));
 return {effective,rawSeries:series,seriesReceivedAt,eventFeePages:pages,nextFeeChangeAt:future[0]?.scheduled_ts??null};
}
/** Cheap verification of an untrusted commitment proposal. A cash token is
 * consumed once across all selected actions, including simultaneous YES/NO bids.
 * Acceptance is for a research scenario; live admission and authority stay separate. */
export function verifyWeatherParticipationProposal(snapshot,{actionIds},{now=Date.now()}={}){
 if(!Array.isArray(actionIds)||actionIds.length<1||actionIds.length>2*snapshot.rows.length||new Set(actionIds).size!==actionIds.length)throw new TypeError('distinct proposed actions bounded by two commitments per captured contract required');
 const actions=new Map(),questions=new Map();for(const row of snapshot.rows){
  for(const action of row.actions.alternatives){if(actions.has(action.id))throw new TypeError('ambiguous captured action identity');actions.set(action.id,{row,action});}
  for(const q of row.actions.questions){const list=questions.get(q.locus)??[];list.push(q);questions.set(q.locus,list);}
 }
 const chosen=[],conflicts=[],keys=new Set(),waiting=new Set(),committed=new Set(),restingPrices=new Map();
 for(const id of actionIds){const captured=actions.get(id);if(!captured)throw new TypeError('unknown proposed action');const {row,action}=captured;
  if(clock(row.actions.expiresAt)<=now||clock(row.actions.observedAt)>now)throw new TypeError('proposal evidence expired or future');
  const key=row.ticker+':'+(action.side??'wait');
  if(action.action==='wait'){if(committed.has(row.ticker))conflicts.push(row.ticker);waiting.add(row.ticker);}else if(waiting.has(row.ticker)||keys.has(key))conflicts.push(key);
  if(action.action==='rest'){
   const prices=restingPrices.get(row.ticker)??new Map(),opposite=prices.get(action.side==='yes'?'no':'yes');
   if(opposite!==undefined&&opposite+action.pips>=ONE)conflicts.push(row.ticker+':crossing-resting-quotes');
   prices.set(action.side,action.pips);restingPrices.set(row.ticker,prices);
  }
  keys.add(key);committed.add(row.ticker);chosen.push({...action,ticker:row.ticker});
 }
 const reservedPips=chosen.reduce((s,a)=>s+Math.ceil((a.capitalRequiredUsd??0)*10000-1e-6),0),availableUsd=snapshot.availableCapitalUsd,reservedUsd=reservedPips/10000;
 if(!Number.isFinite(availableUsd)||availableUsd<0||!Number.isSafeInteger(Math.floor(availableUsd*10000+1e-6))||!Number.isSafeInteger(reservedPips))throw new TypeError('captured cash scope required');
 const availablePips=Math.floor(availableUsd*10000+1e-6);
 return {status:conflicts.length||reservedPips>availablePips?'refused':'verified-research-scenario',conflictingCommitments:conflicts,cashDeficitUsd:Math.max(0,reservedPips-availablePips)/10000,reservedUsd,remainingUsd:(availablePips-reservedPips)/10000,commitments:chosen,unansweredQuestions:chosen.flatMap(a=>questions.get(a.id)??[]),orderEffect:false,tradeAuthority:false};
}
